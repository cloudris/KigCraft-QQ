# Copy to .env; keep secrets on the server. Never commit .env or data/.
HOST=127.0.0.1
PORT=18940
PUBLIC_URL=https://your-editor.example.com
INTERNAL_TOKEN=replace-with-64-random-hex-characters
FAL_KEY=
PAID_ENABLED=false
# Budget reservations are deliberately conservative, NOT a FAL invoice.
# Set false to remove BOTH cumulative call and dollar-reservation caps.
# This never disables weekly Credits, access checks or the PAID_ENABLED switch.
BUDGET_LIMIT_ENABLED=true
# When enabled: four calls at most; no automatic replenishment.
BUDGET_USD=8
RESERVE_USD=2
MAX_PAID_CALLS=4
ALLOWED_GROUPS=123456789
# Other allowed groups stay restricted to these users; empty allows everyone.
ALLOWED_USERS=123456789
# Subset of ALLOWED_GROUPS open to every member (no change to ordinary chat rules).
PUBLIC_GROUPS=
WEEKLY_CREDITS=8
# QQ IDs exempt from weekly Credits, but NOT the shared FAL budget limit.
CREDIT_EXEMPT_USERS=123456789
DATA_DIR=./data
LINK_HOURS=48
